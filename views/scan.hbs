<div class="container mx-auto py-4 scan">
    <div class="p-3 mb-3">
        <h1 class="font-bold text-3xl mb-2">Add new origin configuration </h1>
        <p>Add new origin</p>
        <div class="flex gap-3 my-4">
            <input type="text" class="border">
            <select name="" id="" class="border">
                <option value="">HTTP</option>
                <option value="">HTTPS</option>
            </select>
            <input type="text" placeholder="port" class="border">
            <button class="bg-green-800 text-white px-4 py-2 rounded cursor-pointer">Add Entry</button>
        </div>
    </div>
    <div>
        <table class="border w-full">
            <tr>
                <th>Domain name</th>
                <th>Protocol</th>
                <th>Port</th>
            </tr>
            <tr>

            </tr>
        </table>
    </div>

{{#if result}}
    <hr>
    <h2 class="font-bold text-2xl my-2">Scan Report</h2>
    <table class="border w-1/2">
        <tr>
            <th> Index </th>
            <th> Values </th>
        </tr>
        <tr>
            <td> Website </td>
            <td>{{result.seedUrl }}</td>
        </tr>
        <tr>
            <td> PagesVisited </td>
            <td> {{result.pagesVisited }}</td>
        </tr>
        <tr>
            <td> Total Messages </td>
            <td> {{result.totalMessages }}</td>
        </tr>
        <tr>
            <td> Outgoing Messages </td>
            <td> {{result.outgoing }}</td>
        </tr>
        <tr>
            <td> Incoming Messages </td>
            <td> {{result.incoming }}</td>
        </tr>
        <tr>
            <td> Wildcard Outgoing </td>
            <td> {{result.wildcardOutgoing }}</td>
        </tr>
        <tr>
            <td> Heuristic </td>
            <td> {{result.incomingNoOriginCheckHeuristic }}</td>
        </tr>
    </table>
{{/if}} 
</div>