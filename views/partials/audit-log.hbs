<div class="bg-[#606c38]">
    <div class="flex items-center justify-between px-6 pt-5 pb-4">
      <h1 class="text-cyan-300 text-2xl tracking-wide">Audit Log</h1>

      <div class="flex-1 mx-8 max-w-md relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input type="text" placeholder="Search"
          class="w-full bg-[#0d1a25] border border-slate-700/60 rounded-md pl-9 pr-3 py-1.5 text-sm text-slate-300 placeholder-slate-500 focus:outline-none focus:border-cyan-600">
      </div>

      <div class="flex items-center gap-2 text-sm whitespace-nowrap">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-emerald-400">Live</span>
        <span class="text-slate-500">•</span>
        <span class="text-slate-400">[2023-10-26 14:32:15 UTC]</span>
      </div>
    </div>

    <!-- Filters -->
    <div class="flex items-center gap-3 px-6 pb-4">
      <div class="flex flex-col">
        <label class="text-[11px] text-slate-500 mb-0.5">Start Date:</label>
        <input value="2023-10-26" class="bg-[#0d1a25] border border-slate-700/60 rounded-md px-3 py-1.5 text-sm text-slate-300 w-36 focus:outline-none">
      </div>
      <div class="flex flex-col">
        <label class="text-[11px] text-slate-500 mb-0.5">End Date:</label>
        <input value="2023-10-26" class="bg-[#0d1a25] border border-slate-700/60 rounded-md px-3 py-1.5 text-sm text-slate-300 w-36 focus:outline-none">
      </div>

      <select class="bg-[#0d1a25] border border-slate-700/60 rounded-md px-3 py-2 text-sm text-slate-300 focus:outline-none ml-2">
        <option>Source IP</option>
      </select>
      <select class="bg-[#0d1a25] border border-slate-700/60 rounded-md px-3 py-2 text-sm text-slate-300 focus:outline-none">
        <option>Event Type</option>
      </select>

      <div class="flex-1"></div>

      <button class="bg-[#0d1a25] border border-slate-700/60 rounded-md px-4 py-2 text-sm text-slate-200 hover:bg-[#132433]">Export JSON</button>
      <button class="bg-[#0d1a25] border border-slate-700/60 rounded-md px-4 py-2 text-sm text-slate-200 hover:bg-[#132433]">Export PDF</button>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-cyan-300/90 text-left border-b border-slate-800">
            <th class="px-6 py-2 font-normal">Timestamp <span class="text-xs">▾</span></th>
            <th class="px-3 py-2 font-normal">Event Type</th>
            <th class="px-3 py-2 font-normal">Origin</th>
            <th class="px-3 py-2 font-normal">Target</th>
            <th class="px-6 py-2 font-normal">Decision</th>
          </tr>
        </thead>
        <tbody id="log-body" class="divide-y divide-slate-800/60"></tbody>
      </table>
    </div>

    <!-- Footer -->
    <div class="flex items-center justify-between px-6 py-3 text-sm text-slate-400">
      <span>Showing 1-25 of 14,582 events</span>
      <div class="flex items-center gap-3 text-slate-500">
        <button class="hover:text-slate-300">&lsaquo;</button>
        <button class="hover:text-slate-300">&rsaquo;</button>
      </div>
    </div>
</div>

<script>
// Badge + row styling config per event type
const eventStyles = {
  "Message Blocked":      { icon: "⊘", badge: "bg-rose-950/60 text-rose-300 border border-rose-800/60" },
  "Policy Violation":     { icon: "⚠", badge: "bg-rose-950/60 text-rose-300 border border-rose-800/60" },
  "Handler Registered":   { icon: "⚙", badge: "bg-sky-950/60 text-sky-300 border border-sky-800/60" },
  "API Access":           { icon: "♦", badge: "bg-emerald-950/60 text-emerald-300 border border-emerald-800/60" },
  "Authentication Fail":  { icon: "🔒", badge: "bg-amber-950/60 text-amber-300 border border-amber-800/60" },
};

const decisionStyles = {
  "Denied":     "text-rose-300",
  "Blocked":    "bg-rose-500/90 text-white px-2 py-0.5 rounded",
  "Registered": "text-sky-300",
  "Permitted":  "text-emerald-300",
};

const rowTint = {
  "Blocked": "bg-rose-950/30",
  "Denied":  "bg-rose-950/10",
  "Permitted": "bg-emerald-950/20",
};

const rows = [
  ["14:32:15.882","Message Blocked","192.168.1.105 (SMTP)","user@victim.com","Denied"],
  ["14:32:15.511","Policy Violation","sales_terminal_03","sensitive_data.docx","Blocked"],
  ["14:32:15.199","Handler Registered","svc_app_monitor","API/v2/events","Registered"],
  ["14:32:14.992","API Access","10.50.12.4","/config/secrets","Permitted"],
  ["14:32:14.995","Authentication Fail","sales_terminal_03","user@victim.com","Permitted"],
  ["14:32:15.892","Message Blocked","svc_app_monitor","user@victim.com","Denied"],
  ["14:32:15.836","Handler Registered","svc_app_monitor","API/v2/events","Registered"],
  ["14:32:15.511","Policy Violation","sales_terminal_03","sensitive_data.docx","Blocked"],
  ["14:32:15.819","Handler Registered","svc_app_monitor","API/v2/events","Registered"],
  ["14:32:15.511","Policy Violation","sales_terminal_03","sensitive_data.docx","Blocked"],
  ["14:32:15.199","Handler Registered","10.50.12.4","API/v2/events","Registered"],
  ["14:32:14.992","API Access","10.50.12.4","/config/secrets","Permitted"],
  ["14:32:14.992","API Access","10.50.12.4","/config/secrets","Permitted"],
  ["14:32:14.985","Message Blocked","sales_terminal_03","user@victim.com","Permitted"],
  ["14:32:15.511","Policy Violation","sales_terminal_03","API/v2/events","Blocked"],
  ["14:32:14.999","Handler Registered","10.50.12.4","/config/secrets","Permitted"],
  ["14:32:14.992","API Access","10.50.12.4","/config/secrets","Permitted"],
  ["14:32:14.992","Authentication Fail","10.50.12.4","/config/secrets","Permitted"],
  ["14:32:15.983","Message Blocked","192.168.1.105","user@victim.com","Permitted"],
];

const tbody = document.getElementById("log-body");
rows.forEach(([ts, type, origin, target, decision]) => {
  const style = eventStyles[type];
  const tint = rowTint[decision] || "";
  const tr = document.createElement("tr");
  tr.className = tint + " hover:bg-white/5";
  tr.innerHTML = `
    <td class="px-6 py-2 text-slate-300 whitespace-nowrap">[${ts}]</td>
    <td class="px-3 py-2 whitespace-nowrap">
      <span class="inline-flex items-center gap-1.5 text-xs px-2 py-1 rounded-full ${style.badge}">
        <span>${style.icon}</span>${type}
      </span>
    </td>
    <td class="px-3 py-2 text-slate-300 whitespace-nowrap">[${origin}]</td>
    <td class="px-3 py-2 text-slate-300 whitespace-nowrap">[${target}]</td>
    <td class="px-6 py-2 whitespace-nowrap">
      <span class="text-xs ${decisionStyles[decision]}">${decision === "Blocked" ? decision : "[" + decision + "]"}</span>
    </td>
  `;
  tbody.appendChild(tr);
});
</script>

