<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPAMF Dashboard</title>
    <link rel="stylesheet" href="/css/output.css">
    <script src="/js/alpine.js" defer></script>
    <script src="/js/lucide.js"></script>
</head>
<body class="h-dvh bg-[#e9edc9]" x-data="{screen: 'dashboard'}">
    <div class="flex h-full">
        <aside class="w-2/12 py-4 bg-[#a7c957]">
            <h1 class="text-[#fefae0] font-extrabold text-3xl ms-3 mb-6">SPAMF</h1>
            <div class="flex flex-col gap-4">
                <a href="#" class="flex items-center gap-3 px-3 py-3 hover:bg-white/5"
                @click="screen = 'dashboard'" :class="screen === 'dashboard' ? 'bg-[#ecf39e]' : ''">
                    <i data-lucide="LayoutDashboard" :class="screen === 'dashboard' ? 'text-[#70593c]' : ''" ></i> Dashboard
                </a>
                <a href="#" class="flex items-center gap-3 px-3 py-3 hover:bg-white/5"
                @click="screen = 'audit-log'" :class="screen === 'audit-log' ? 'bg-[#ecf39e]' : ''">
                    <i data-lucide="Grid2X2" :class="screen === 'audit-log' ? 'text-[#70593c]' : ''" ></i> Audit
                </a>
                <a href="#" class="flex items-center gap-3 px-3 py-3"
                @click="screen = 'vulnerability'" :class="screen === 'vulnerability' ? 'bg-[#ecf39e]' : ''">
                    <i data-lucide="Shield" :class="screen === 'vulnerability' ? 'text-[#70593c]' : ''" ></i> Vulnerability
                </a>
                <a href="#" class="flex items-center gap-3 pl-10 pr-3 py-3 text-sm"
                @click="screen = 'manifest'" :class="screen === 'manifest' ? 'bg-[#ecf39e]' : ''">
                    <i data-lucide="FileText" :class="screen === 'manifest' ? 'text-[#70593c]' : ''" ></i> Manifest
                </a>
                <a href="#" class="flex items-center gap-3 px-3 py-3  hover:bg-white/5 mt-2"
                @click="screen = 'notifications'" :class="screen === 'notifications' ? 'bg-[#ecf39e]' : ''">
                    <i data-lucide="Bell" :class="screen === 'notifications' ? 'text-[#70593c]' : ''" ></i> Notifications
                </a>
                <a href="#" class="flex items-center gap-3 px-3 py-3 hover:bg-white/5"
                @click="screen = 'services'" :class="screen === 'services' ? 'bg-[#ecf39e]' : ''">
                    <i data-lucide="Settings" :class="screen === 'services' ? 'text-[#70593c]' : ''" ></i> Services
                </a>
                <a href="#" class="flex items-center gap-3 px-3 py-3 rounded-md hover:bg-white/5"
                @click="screen = 'help'" :class="screen === 'help' ? 'bg-[#ecf39e]' : ''">
                    <i data-lucide="HelpCircle" :class="screen === 'help' ? 'text-[#70593c]' : ''" ></i> Help
                </a>
                <a href="#" class="flex items-center gap-3 px-3 py-3 rounded-md hover:bg-white/5"
                @click="screen = 'settings'" :class="screen === 'settings' ? 'bg-[#ecf39e]' : ''">
                    <i data-lucide="Cog" :class="screen === 'settings' ? 'text-[#70593c]' : ''"></i> Settings
                </a>
            </div>
        </aside>
        <div class="w-10/12 p-6 overflow-scroll">
            <nav class="" x-show="screen === 'dashboard'">
                <h1 class="text-3xl font-bold">{{title}}</h1>
            </nav>
            <div>
                {{{body}}}
            </div>
        </div>
    </div>
    <script type="text/javascript">
        lucide.createIcons();
    </script>
</body>
</html>